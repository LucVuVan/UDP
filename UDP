        ois.close();
        System.out.println("Truoc: " + p);

        // c. finalPrice = round2(basePrice * (1 + tax/100) * (1 - discount/100))
        double price = p.getBasePrice()
                * (1 + p.getTaxRate() / 100.0)
                * (1 - p.getDiscountRate() / 100.0);
        p.setFinalPrice(Math.round(price * 100.0) / 100.0);
        System.out.println("Sau:   " + p);

        // d. Gửi 8 byte requestId + object đã cập nhật
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        baos.write(reqIdBytes);
        ObjectOutputStream oos = new ObjectOutputStream(baos);
        oos.writeObject(p);
        oos.flush();
        byte[] resp = baos.toByteArray();
        socket.send(new DatagramPacket(resp, resp.length, addr, port));

        // e. Đóng socket
        socket.close();
    }
}

