public class Bai2 {
    public static void main(String[] args) throws Exception {
        String host = "203.162.10.109";
        int port = 2209;
        String studentCode = "B23DCCN517";
        String qCode = "XXXXXXXX"; // điền mã câu hỏi thật

        DatagramSocket socket = new DatagramSocket();
        socket.setSoTimeout(5000);
        InetAddress addr = InetAddress.getByName(host);

        // Gửi ;studentCode;qCode
        byte[] out = (";" + studentCode + ";" + qCode).getBytes("UTF-8");
        socket.send(new DatagramPacket(out, out.length, addr, port));

        // Nhận: 8 byte requestId + object Product
        byte[] buf = new byte[65507];
        DatagramPacket in = new DatagramPacket(buf, buf.length);
        socket.receive(in);

        byte[] data = Arrays.copyOf(in.getData(), in.getLength());
        byte[] reqIdBytes = Arrays.copyOfRange(data, 0, 8);

        ObjectInputStream ois = new ObjectInputStream(
                new ByteArrayInputStream(data, 8, data.length - 8));
        Product p = (Product) ois.readObject();
        ois.close();
        System.out.println("Truoc khi sua: " + p);

        // Sửa tên: đổi chỗ từ đầu và từ cuối
        String[] words = p.getName().trim().split("\\s+");
        if (words.length >= 2) {
            String tmp = words[0];
            words[0] = words[words.length - 1];
            words[words.length - 1] = tmp;
        }
        p.setName(String.join(" ", words));

        // Sửa số lượng: đảo ngược các chữ số
        int q = p.getQuantity();
        boolean neg = q < 0;
        String rev = new StringBuilder(String.valueOf(Math.abs(q))).reverse().toString();
        int newQ = Integer.parseInt(rev);
        p.setQuantity(neg ? -newQ : newQ);
        System.out.println("Sau khi sua:   " + p);

        // Gửi: 8 byte requestId + object đã sửa
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        baos.write(reqIdBytes);
        ObjectOutputStream oos = new ObjectOutputStream(baos);
        oos.writeObject(p);
        oos.flush();
        byte[] resp = baos.toByteArray();
        socket.send(new DatagramPacket(resp, resp.length, addr, port));

        socket.close();
    }
}

Đề 3. Giải mã URL query string, sắp key (cổng 2208, hai pha)
import java.net.*;
import java.util.*;

public class Bai3 {
    public static void main(String[] args) throws Exception {
        String host = "203.162.10.109";
        int port = 2208;
        String studentCode = "B23DCCN517";
        String qCode = "XXXXXXXX"; // điền mã câu hỏi thật

        DatagramSocket socket = new DatagramSocket();
        socket.setSoTimeout(5000);
        InetAddress addr = InetAddress.getByName(host);

        // a. Gửi ;studentCode;qCode
        byte[] out = (";" + studentCode + ";" + qCode).getBytes("UTF-8");
        socket.send(new DatagramPacket(out, out.length, addr, port));

        // b. Nhận requestId;data
        byte[] buf = new byte[65507];
        DatagramPacket in = new DatagramPacket(buf, buf.length);
        socket.receive(in);
        String received = new String(in.getData(), 0, in.getLength(), "UTF-8").trim();
        System.out.println("Nhan: " + received);

        String[] parts = received.split(";", 2);
        String requestId = parts[0];
        String data = parts.length > 1 ? parts[1] : "";

        // c. Tách, giải mã, sắp xếp theo key
        List<String[]> pairs = new ArrayList<>();
        if (!data.isEmpty()) {
            for (String kv : data.split("&")) {
                if (kv.isEmpty()) continue;
                int idx = kv.indexOf('=');
                String k = idx >= 0 ? kv.substring(0, idx) : kv;
                String v = idx >= 0 ? kv.substring(idx + 1) : "";
                k = URLDecoder.decode(k, "UTF-8");
                v = URLDecoder.decode(v, "UTF-8");
                pairs.add(new String[]{k, v});
            }
        }
        // sort ổn định, nếu trùng key vẫn giữ thứ tự xuất hiện ban đầu
        pairs.sort((a, b) -> a[0].compareTo(b[0]));

        // d. Ghép key=value;key=value
        StringBuilder sb = new StringBuilder(requestId);
        for (String[] p : pairs) {
            sb.append(";").append(p[0]).append("=").append(p[1]);
        }
        String result = sb.toString();

        byte[] resp = result.getBytes("UTF-8");
        socket.send(new DatagramPacket(resp, resp.length, addr, port));
        System.out.println("Gui: " + result);

        // e. Đóng socket
        socket.close();
    }
}

