import java.net.*;
import java.util.*;

public class Bai1 {
    public static void main(String[] args) throws Exception {
        String host = "203.162.10.109";
        int port = 2208;
        String studentCode = "B23DCCN517";
        String qCode = "XXXXXXXX"; // điền mã câu hỏi thật

        DatagramSocket socket = new DatagramSocket();
        socket.setSoTimeout(5000);
        InetAddress addr = InetAddress.getByName(host);

        // a. Gửi ;studentCode;qCode
        byte[] out = (";" + studentCode + ";" + qCode).getBytes("UTF-8");
        socket.send(new DatagramPacket(out, out.length, addr, port));

        // b. Nhận requestId;str1;str2
        byte[] buf = new byte[4096];
        DatagramPacket in = new DatagramPacket(buf, buf.length);
        socket.receive(in);
        String received = new String(in.getData(), 0, in.getLength(), "UTF-8").trim();
        System.out.println("Nhan: " + received);

        String[] parts = received.split(";", 3);
        String requestId = parts[0];
        String str1 = parts[1];
        String str2 = parts[2];

        // c. Loại bỏ ký tự của str1 xuất hiện trong str2
        Set<Character> set = new HashSet<>();
        for (char c : str2.toCharArray()) set.add(c);

        StringBuilder sb = new StringBuilder();
        for (char c : str1.toCharArray()) {
            if (!set.contains(c)) sb.append(c);
        }
        String strOutput = sb.toString();

        byte[] resp = (requestId + ";" + strOutput).getBytes("UTF-8");
        socket.send(new DatagramPacket(resp, resp.length, addr, port));
        System.out.println("Gui: " + requestId + ";" + strOutput);

        // d. Đóng socket
        socket.close();
    }
}

